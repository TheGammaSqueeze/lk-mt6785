// AArch64 EL1 host for a 32 bit EL0 guest (the GBA core's CPU loop) on a second core.
// Layout: exception vectors (0x800 bytes, the blob is 2 KB aligned), then the entry at +0x800.
// SRAM page words: +32 shared block, +36 page table, +40 guest entry, +44 guest stack top.
// Shared block bytes: 112 stop, 128 ESR, 132 ELR, 136 FAR, 140 SPSR, 144 flush calls, 148 fault
// flag, 152 restart request.
// The guest arms this core's virtual timer for the length of each frame it runs (interrupt 27): a
// guest that stalls is cut off by that interrupt and held like one that faulted (fault flag 2).
// A guest that faults is held here: the host records the fault and sleeps until the boot core asks
// for a restart (the guest then starts again from its entry, on its stack, with fresh tables) or
// for the core to stop. The core is never left spinning and never has to be powered off to recover.
.macro	vec to
	.balign	0x80
	b	\to
.endm
vectors:
	vec fault
	vec fault
	vec fault
	vec fault
	vec fault
	vec fault
	vec fault
	vec fault
	vec fault
	vec fault
	vec fault
	vec fault
	vec sync32			// +0x600: synchronous, from the 32 bit guest
	vec irq32			// +0x680: an interrupt while the guest ran
	vec fault
	vec fault
	.balign	0x800
entry:
	movz	x7, #0xd7c0
	movk	x7, #0x11, lsl #16
	mov	w6, #0xb0
	str	w6, [x7, #8]
	ldr	w9, [x7, #32]
	ldr	w10, [x7, #36]
	ldr	w11, [x7, #40]
	ldr	w12, [x7, #44]
	dsb	sy
	movz	x1, #0x00ff
	msr	mair_el1, x1
	movz	x1, #0x3519
	movk	x1, #0x0080, lsl #16
	msr	tcr_el1, x1
	msr	ttbr0_el1, x10
	adr	x1, vectors
	msr	vbar_el1, x1
	mov	x1, #0x300000		// CPACR_EL1.FPEN: FP and SIMD for EL0 and EL1
	msr	cpacr_el1, x1
	mov	x1, #0x103		// CNTKCTL_EL1: the counters readable from EL0, the virtual timer the guest's
	msr	cntkctl_el1, x1
	msr	cntv_ctl_el0, xzr
	// this core's interrupt interface: only the virtual timer (27) is let through
	mrs	x1, mpidr_el1
	ubfx	x1, x1, #8, #8
	movz	x2, #0x0c05, lsl #16	// redistributor SGI frames: 0x0C050000 + core * 0x20000
	add	x2, x2, x1, lsl #17
	mov	w3, #0x08000000
	str	w3, [x2, #0x100]	// GICR_ISENABLER0
	mrs	x1, S3_0_C12_C12_5	// ICC_SRE_EL1
	orr	x1, x1, #1
	msr	S3_0_C12_C12_5, x1
	isb
	mrs	x1, S3_0_C12_C12_4	// ICC_CTLR_EL1: one write ends an interrupt (EOImode 0)
	bic	x1, x1, #2
	msr	S3_0_C12_C12_4, x1
	mov	x1, #0xff
	msr	S3_0_C4_C6_0, x1	// ICC_PMR_EL1
	mov	x1, #1
	msr	S3_0_C12_C12_7, x1	// ICC_IGRPEN1_EL1
	dsb	sy
	isb
	tlbi	vmalle1
	dsb	sy
	isb
	.inst	0xd500409f		// msr pan, #0: EL1 may touch the guest's pages
	mrs	x1, sctlr_el1
	orr	x1, x1, #0x1		// M
	orr	x1, x1, #0x4		// C
	orr	x1, x1, #0x1000		// I
	orr	x1, x1, #0x20		// CP15BEN: the guest's cp15 barriers
	orr	x1, x1, #0x10000	// nTWI
	orr	x1, x1, #0x40000	// nTWE
	orr	x1, x1, #0x4000000	// UCI: the guest runs DC CVAU/CVAC/CIVAC, IC IVAU itself (no trap)
	orr	x1, x1, #0x8000		// UCT: the guest may read CTR_EL0 (cache line size)
	bic	x1, x1, #0x2		// A: unaligned loads are the guest's business
	bic	x1, x1, #0x80000	// WXN
	orr	x1, x1, #0x800000	// SPAN: taking an exception does not set PAN
	msr	sctlr_el1, x1
	isb
reenter:
	movz	x7, #0xd7c0
	movk	x7, #0x11, lsl #16
	ldr	w9, [x7, #32]
	ldr	w11, [x7, #40]
	ldr	w12, [x7, #44]
	mov	w6, #0xb1
	str	w6, [x7, #8]
	msr	cntv_ctl_el0, xzr
	mov	x3, #0x150		// AArch32 User, A and F masked: the timer interrupt gets through
	tbz	x11, #0, 1f
	orr	x3, x3, #0x20		// Thumb entry
	bic	x11, x11, #1
1:	msr	spsr_el1, x3
	msr	elr_el1, x11
	mov	x13, x12		// the guest's sp
	msr	sp_el0, x12
	mov	x14, #0
	mov	x0, x9
	eret

sync32:
	mrs	x16, esr_el1
	lsr	x17, x16, #26
	cbnz	x17, 6f
	// an undefined instruction: the guest's privileged cache operations (Thumb mcr p15, 0, rt, c7, ...)
	mrs	x18, elr_el1
	mrs	x19, spsr_el1
	tbz	x19, #5, fault
	ldrh	w20, [x18]
	ldrh	w21, [x18, #2]
	movz	w22, #0xee07
	cmp	w20, w22
	b.ne	fault
	and	w22, w21, #0x0f00
	cmp	w22, #0x0f00
	b.ne	fault
	ubfx	w23, w21, #12, #4
	adr	x24, 8f
	add	x24, x24, x23, lsl #3
	br	x24
8:
	mov	x25, x0
	b	7f
	mov	x25, x1
	b	7f
	mov	x25, x2
	b	7f
	mov	x25, x3
	b	7f
	mov	x25, x4
	b	7f
	mov	x25, x5
	b	7f
	mov	x25, x6
	b	7f
	mov	x25, x7
	b	7f
	mov	x25, x8
	b	7f
	mov	x25, x9
	b	7f
	mov	x25, x10
	b	7f
	mov	x25, x11
	b	7f
	mov	x25, x12
	b	7f
	mov	x25, x13
	b	7f
	mov	x25, x14
	b	7f
	mov	x25, xzr
	b	7f
7:	and	w26, w21, #0xf		// CRm
	ubfx	w27, w21, #5, #3	// opc2
	cmp	w26, #11
	b.ne	71f
	dc	cvau, x25
	b	79f
71:	cmp	w26, #10
	b.ne	72f
	dc	cvac, x25
	b	79f
72:	cmp	w26, #14
	b.ne	73f
	dc	civac, x25
	b	79f
73:	cmp	w26, #5
	b.ne	79f
	cmp	w27, #1
	b.ne	74f
	ic	ivau, x25
	b	79f
74:	cbnz	w27, 79f
	ic	iallu
79:	add	x18, x18, #4
	msr	elr_el1, x18
	movz	x20, #0xd7c0
	movk	x20, #0x11, lsl #16
	ldr	w21, [x20, #32]
	ldr	w22, [x21, #144]
	add	w22, w22, #1
	str	w22, [x21, #144]
	eret
6:	cmp	x17, #0x11		// SVC from AArch32
	b.ne	fault
	movz	w17, #0x0002
	movk	w17, #0x000f, lsl #16	// 0xF0002: cacheflush(start, end)
	cmp	w7, w17
	b.eq	5f
	movz	w17, #0x00ff
	movk	w17, #0x000f, lsl #16	// 0xF00FF: the guest asks to power this core off
	cmp	w7, w17
	b.ne	fault
	movz	x0, #0x0002
	movk	x0, #0x8400, lsl #16	// PSCI_CPU_OFF
	smc	#0
	b	fault
5:
	and	x18, x0, #0xffffffc0
	mov	w19, w1
2:	dc	cvau, x18
	add	x18, x18, #64
	cmp	x18, x19
	b.lo	2b
	dsb	ish
	and	x18, x0, #0xffffffc0
3:	ic	ivau, x18
	add	x18, x18, #64
	cmp	x18, x19
	b.lo	3b
	dsb	ish
	isb
	movz	x20, #0xd7c0
	movk	x20, #0x11, lsl #16
	ldr	w21, [x20, #32]
	ldr	w22, [x21, #144]
	add	w22, w22, #1
	str	w22, [x21, #144]
	mov	x0, #0
	eret

irq32:
	mrs	x16, S3_0_C12_C12_0	// ICC_IAR1_EL1
	and	w17, w16, #0xffffff
	cmp	w17, #27
	b.eq	1f
	msr	S3_0_C12_C12_1, x16	// ICC_EOIR1_EL1
	eret				// anything else is not ours
1:	msr	cntv_ctl_el0, xzr	// the line drops before the interrupt is ended
	isb
	msr	S3_0_C12_C12_1, x16
	mov	w15, #2			// the frame watchdog
	b	2f
fault:
	mov	w15, #1
2:	msr	cntv_ctl_el0, xzr
	movz	x20, #0xd7c0
	movk	x20, #0x11, lsl #16
	ldr	w21, [x20, #32]
	mrs	x16, esr_el1
	str	w16, [x21, #128]
	mrs	x16, elr_el1
	str	w16, [x21, #132]
	mrs	x16, far_el1
	str	w16, [x21, #136]
	mrs	x16, spsr_el1
	str	w16, [x21, #140]
	str	w15, [x21, #148]
	mov	w16, #0xbf
	str	w16, [x20, #8]
4:	dmb	sy
	ldr	w16, [x21, #112]	// stop: the console resets or powers off
	cbnz	w16, 9f
	ldr	w16, [x21, #152]	// restart request
	cbnz	w16, 8f
	wfe				// the boot core's sev follows each request
	b	4b
8:	str	wzr, [x21, #148]
	str	wzr, [x21, #152]
	dsb	sy
	tlbi	vmalle1			// the boot core rebuilt the tables
	dsb	sy
	isb
	b	reenter
9:	movz	x0, #0x0002
	movk	x0, #0x8400, lsl #16	// PSCI_CPU_OFF
	smc	#0
	b	4b
